# PostgreSQL(asyncpg)
LKM_DB_HOST=localhost
LKM_DB_PORT=5432
LKM_DB_NAME=lkm
LKM_DB_USER=postgres
LKM_DB_PASSWORD=

# JWT（RS256：私钥签发 / 公钥验签）
# 生成密钥对：sh deploy/jwt/gen-keys.sh
# LKM_JWT_PRIVATE_KEY_FILE=/etc/lkm/jwt/jwt-private.pem   # 仅签发方(auth)需要
# LKM_JWT_PUBLIC_KEY_FILE=/etc/lkm/jwt/jwt-public.pem     # 验签方需要
LKM_ACCESS_TOKEN_EXPIRE_MINUTES=15
# 本地进程：ClamAV 地址留空表示未启用；生产 Compose 默认启用 clamav:3310。
LKM_FILES_CLAMAV_ADDRESS=
# 逗号分隔的敏感词，匹配文件名、描述和能提取的正文。
LKM_FILES_SENSITIVE_TERMS=
LKM_FILES_PREVIEW_MAX_BYTES=52428800
# 备份与低频归档必须挂到独立持久卷；空值表示关闭。
LKM_FILES_BACKUP_DIR=
LKM_FILES_ARCHIVE_DIR=
LKM_FILES_ARCHIVE_AFTER_DAYS=365
LKM_REFRESH_TOKEN_EXPIRE_DAYS=7

# OAuth (GitHub)
LKM_GITHUB_CLIENT_ID=
LKM_GITHUB_CLIENT_SECRET=
LKM_GITHUB_REDIRECT_URI=http://localhost:8000/api/v1/auth/github/callback
LKM_FRONTEND_CALLBACK=http://localhost:5173/login/success

# Passkey (WebAuthn)
LKM_RP_ID=localhost
LKM_RP_NAME=LKM Service
LKM_ORIGIN=http://localhost:5173

# Redis（缓存/限流/WS/锁/上传标记）——空串=未启用
LKM_REDIS_URL=
# 消息总线：默认 Pulsar；切换 RabbitMQ 时设置以下两项。
LKM_MESSAGE_BUS=pulsar
LKM_PULSAR_URL=
LKM_PULSAR_ADMIN_URL=
LKM_RABBITMQ_URL=

# 走 create_all 自建表，不走数据迁移，上线之后保留数据需改为 true
LKM_USE_ALEMBIC=false

# 读热路径 msgspec 序列化（列表端点；=false 回退 Pydantic 路径）
LKM_READ_MSGSPEC_ENABLED=true

# 链路追踪 OpenTelemetry（M5 7.2.2；默认关）。启用需 endpoint 指向 collector/SigNoz。
LKM_OTEL_ENABLED=false
LKM_OTEL_EXPORTER_OTLP_ENDPOINT=
LKM_OTEL_SAMPLE_RATIO=0.1
# LKM_OTEL_SERVICE_NAME=
# LKM_OTEL_EXPORTER_OTLP_HEADERS=

# ClickHouse 分析管道。启用需 `--profile clickhouse` 起 CH+vector，
# 并把本组下发到 backend / worker / prefect-worker。
LKM_CLICKHOUSE_ENABLED=false
LKM_CLICKHOUSE_URL=http://clickhouse:8123
LKM_CLICKHOUSE_DATABASE=lkm
LKM_CLICKHOUSE_USER=lkm
LKM_CLICKHOUSE_PASSWORD=
# LKM_CLICKHOUSE_EXPORT_WINDOW=1000
# LKM_CLICKHOUSE_QUERY_LIMIT_MAX=200

# AUTH 独立库
LKM_AUTH_DB_HOST=localhost
LKM_AUTH_DB_PORT=5432
LKM_AUTH_DB_NAME=lkm_auth
LKM_AUTH_DB_USER=postgres
LKM_AUTH_DB_PASSWORD=

LKM_AUTH_HTTP_URL=http://localhost:8001
LKM_AUTH_HTTP_TOKEN=

# 注册准入：open=注册即可用（默认）；apply=注册进待审，管理员通过后才可登录。
LKM_ADMISSION_MODE=open

# 每日待办摘要的可选 bot 推送（LKM-bot OpenAPI /api/v1/im/messages，im scope api key）。
# 三项全部配置才启用；推送失败只告警，站内信不受影响。
LKM_BOT_PUSH_URL=
LKM_BOT_PUSH_API_KEY=
LKM_BOT_PUSH_UMO=

# 仅 dev/local/test：允许 /auth/internal/dev-code 为 register 铸造验证码（金路径脚本用）。
# 生产（非宽松环境）开启会导致启动校验失败。
LKM_DEV_CODE_SINK=0
