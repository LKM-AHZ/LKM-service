# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info
docs/

# 工具链缓存/覆盖率产物（与 .dockerignore 对齐)
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# IDE / 编辑器
.vscode/
.idea

# Virtual environments
.venv

# Development environment files
.env
.env.*
!.env.example
*.pem
*.key
*.p12
id_rsa*
secrets/
DeveloperLog.md
AUTH_DESIGN.md
SQLALCHEMY_MIGRATION.md

# blog git repos (bare repos generated at runtime)
blog_repos/

